# NOTE: this file is sourced by deploy.sh as well as read by Docker Compose.
# Quote any value containing spaces or shell-special characters (<, >, &, ...).

# ============================================================================
# Database Configuration
# ============================================================================
DB_NAME=revel_db
DB_USER=revel_user
DB_PASSWORD=change_me_in_production
DB_HOST=pgbouncer
DB_PORT=6432
DB_USE_PGBOUNCER=True
# Will be set to 0 if DB_USE_PGBOUNCER=True
DB_CONN_MAX_AGE=60
# Will only be used if DB_USE_PGBOUNCER=False
DB_CONN_HEALTH_CHECKS=True

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
# One Redis instance, partitioned by logical DB index. Keep these three disjoint:
# the index is a namespace, not an isolation boundary, and a FLUSHDB on one index
# (which is what Django's cache.clear() compiles to) wipes everything sharing it.
#   CACHE_REDIS_DB=2    Django cache            (this file, below)
#   CELERY_REDIS_DB=0   Celery broker           (Celery Configuration section)
#   AIOGRAM_REDIS_DB=1  Telegram bot FSM state  (Telegram Bot Configuration section)
# Changing CACHE_REDIS_DB is safe at any time — the next deploy just starts on a
# cold cache. Changing CELERY_REDIS_DB strands queued tasks; changing
# AIOGRAM_REDIS_DB drops in-flight bot conversations.
CACHE_REDIS_DB=2

# ============================================================================
# Django Core Configuration
# ============================================================================
SECRET_KEY=change_me_in_production
SALT_KEY=change_me_in_production
DEBUG=False
DEMO_MODE=False
# Must include `web` — the frontend's SSR calls reach the API as http://web:8000,
# so Django sees Host: web (localhost/127.0.0.1 cover the container healthcheck).
ALLOWED_HOSTS=.letsrevel.io,web,localhost,127.0.0.1
ADMIN_URL=admin/

# ============================================================================
# Site Configuration
# ============================================================================
SITE_NAME=Revel
SITE_DOMAIN=beta-api.letsrevel.io
BASE_URL=https://beta-api.letsrevel.io
FRONTEND_BASE_URL=https://beta.letsrevel.io
SERVICE_DESCRIPTION="The Revel API"

# ============================================================================
# Frontend Configuration (Self-Hosting)
# ============================================================================
# The published frontend image (ghcr.io/letsrevel/revel-frontend) is now
# environment-agnostic: it reads these at RUNTIME (revel-frontend#396), so the
# same prebuilt image can point at any backend — no rebuild required.
#   PUBLIC_API_URL  the public URL of your backend API (what the browser calls)
#   ORIGIN          the public origin of the frontend (required by adapter-node)
# The docker-compose `frontend` service wires these from BASE_URL and
# FRONTEND_BASE_URL above, so for most setups you do not need to set them here.
# Override only if your frontend should call a different API origin:
# PUBLIC_API_URL=https://beta-api.letsrevel.io
# ORIGIN=https://beta.letsrevel.io

# ============================================================================
# Self-Hosting: Compose profiles, reverse proxy, domains, sizing
# ============================================================================
# Optional service groups. Empty = slim (core only: web, frontend, celery, beat,
# postgres, pgbouncer, redis). Full stack: observability,antivirus,telegram
# (each is independent — enable any subset). The login canary is its own opt-in
# 'canary' profile (needs a dedicated account — see the Login Canary section).
COMPOSE_PROFILES=

# Which Caddyfile the caddy service mounts:
#   ./Caddyfile            Cloudflare + legacy redirects (production default)
#   ./Caddyfile.cloudflare self-host behind Cloudflare's proxy
#   ./Caddyfile.generic    self-host with Caddy as the edge (no Cloudflare)
# CADDYFILE_PATH=./Caddyfile.generic

# Domains used by the Caddyfile (the wizard sets these). Default to the prod
# values if unset, so production needs no change.
FRONTEND_DOMAIN=letsrevel.io
API_DOMAIN=api.letsrevel.io
DOCS_DOMAIN=docs.letsrevel.io
GRAFANA_DOMAIN=grafana.letsrevel.io

# Postgres tuning (defaults shown are the FULL/production values).
PG_SHARED_BUFFERS=4GB
PG_EFFECTIVE_CACHE_SIZE=16GB
PG_MAINTENANCE_WORK_MEM=1GB
PG_WORK_MEM=32MB
PG_MAX_CONNECTIONS=100

# Container memory limits and worker sizing (FULL/production defaults).
WEB_MEM_LIMIT=12g
CELERY_MEM_LIMIT=8g
FRONTEND_MEM_LIMIT=2g
REDIS_MEM_LIMIT=1g
# Redis's internal eviction ceiling. MUST stay below REDIS_MEM_LIMIT (the container
# hard limit) or Docker OOM-kills redis before volatile-lru eviction can fire
# (only TTL'd cache keys are evictable; broker keys never are — see docker-compose.yml).
REDIS_MAXMEMORY=512mb
GUNICORN_WORKERS=6
GUNICORN_THREADS=4
CELERY_CONCURRENCY=4
# Per-container CPU caps. A cap must not exceed the host's CPU count or Docker
# refuses to create the container — lower these on a smaller box (see slim preset).
WEB_CPU_LIMIT=6.0
CELERY_CPU_LIMIT=4.0

# ============================================================================
# Feature Flags
# ============================================================================
FEATURE_LLM_EVALUATION=False
# ClamAV upload scanning. Requires the 'antivirus' profile to be in
# COMPOSE_PROFILES — set True only when you actually run it, otherwise uploads
# fail trying to reach a ClamAV daemon that isn't there.
FEATURE_MALWARE_SCAN=False
# Telegram bot integration. Requires the 'telegram' profile in COMPOSE_PROFILES —
# set True only when you run it.
FEATURE_TELEGRAM=False
# Allow regular users to create organizations. Set False for a single-org instance
# (staff/superusers can still create orgs).
FEATURE_ORGANIZATION_CREATION=True

# ============================================================================
# OpenID Connect — user-facing login ("Sign in with Google" etc.)
# ============================================================================
# Optional. Comma-separated provider keys; each key (upper-cased, "-" -> "_")
# needs OIDC_<KEY>_ISSUER, OIDC_<KEY>_CLIENT_ID and OIDC_<KEY>_CLIENT_SECRET.
# Register https://<API_DOMAIN>/api/auth/oidc/<key>/callback as the redirect URI
# on the provider's client (for Google: .../api/auth/oidc/google/callback).
# Leave OIDC_PROVIDERS empty for email/password login only. This replaces the
# removed FEATURE_GOOGLE_SSO flag, which the backend no longer reads.
OIDC_PROVIDERS=
# OIDC_PROVIDERS=google
# OIDC_GOOGLE_ISSUER=https://accounts.google.com
# OIDC_GOOGLE_CLIENT_ID=your_client_id_here
# OIDC_GOOGLE_CLIENT_SECRET=your_client_secret_here

# ============================================================================
# Google SSO — Django ADMIN login only
# ============================================================================
# Optional. Configures django-google-sso for the /admin login; it does NOT enable
# user-facing Google login (that's OIDC_PROVIDERS above). The same Google OAuth
# client can serve both.
# Leave the placeholders to log in to /admin with createsuperuser credentials.
GOOGLE_SSO_CLIENT_ID=your_client_id_here
GOOGLE_SSO_CLIENT_SECRET=your_client_secret_here
GOOGLE_SSO_PROJECT_ID=your_project_id_here
GOOGLE_SSO_SUPERUSER_LIST=admin@yourdomain.com
GOOGLE_SSO_STAFF_LIST=
# Keep True so the admin username/password form is shown. Set False ONLY when
# Google SSO is configured — it forces SSO-only admin login and you can lock
# yourself out of /admin without a working SSO setup.
SSO_SHOW_FORM_ON_ADMIN_PAGE=True

# ============================================================================
# Email Configuration
# ============================================================================
# Production sends through the Brevo SMTP relay (port 587, STARTTLS). Any SMTP
# provider works; the login and key come from the provider's SMTP settings page.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_smtp_login
EMAIL_HOST_PASSWORD=your_smtp_key
EMAIL_USE_SSL=False
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL="Revel <noreply@letsrevel.io>"
# Optional dedicated sending domain for mail that organizations push to people
# (announcements, invitations, event updates and reminders), e.g. mail.letsrevel.io,
# so its reputation is kept apart from account mail (verification, password reset,
# tickets). Unset or empty -> falls back to the domain of DEFAULT_FROM_EMAIL.
# Authenticate the domain (DKIM + DMARC) at your SMTP provider before setting it.
# It needs no MX record, but do NOT publish a null MX (RFC 7505): a null-MX
# domain must not be used as a From domain.
# ORG_EMAIL_DOMAIN=mail.letsrevel.io
# Optional shared secret for the provider's bounce/complaint webhook,
# POST https://<API_DOMAIN>/api/email-events/brevo. Sent as
# "Authorization: Bearer <secret>" or as the basic-auth password, e.g. the URL
# https://revel:<secret>@<API_DOMAIN>/api/email-events/brevo in Brevo's webhook
# settings. Unset or empty -> feature off (the endpoint returns 404).
# EMAIL_WEBHOOK_SECRET=
# Cloudflare Turnstile bot check on registration. Set BOTH to enable; leave both
# empty to disable (a half-set pair stays disabled). Keys: Cloudflare dashboard ->
# Turnstile -> your widget. Rollback = clear them and redeploy.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Org setup nudges (capped, opt-out-able reminders to owners of stalled
# organizations; daily beat task ships DISABLED, enable it in Django admin).
# ORG_NUDGE_REPLY_TO is the Reply-To on those emails so owners can answer a
# person; unset -> no Reply-To and the personal check-in nudge never fires.
# ORG_NUDGE_SIGNATURE signs the check-in (default "The Revel team").
# ORG_NUDGE_REPLY_TO="Your Name <you@yourdomain.com>"
# ORG_NUDGE_SIGNATURE="Your Name"
DEFAULT_BILLING_EMAIL="Billing <billing@yourdomain.com>"
DEFAULT_REPLY_TO_EMAIL="Revel <contact@yourdomain.com>"
INTERNAL_CATCHALL_EMAIL=internal@letsrevel.io
EMAIL_DRY_RUN=False

# ============================================================================
# Celery Configuration
# ============================================================================
# Redis DB index for the broker — see the Redis Configuration section for the
# full index map; must not equal CACHE_REDIS_DB or AIOGRAM_REDIS_DB.
CELERY_REDIS_DB=0
CELERY_TASK_ALWAYS_EAGER=False

# ============================================================================
# JWT & Authentication
# ============================================================================
JWT_ALGORITHM=HS256
JWT_AUDIENCE=letsrevel.io
ACCESS_TOKEN_LIFETIME_HOURS=1
REFRESH_TOKEN_LIFETIME_DAYS=30
VERIFY_TOKEN_LIFETIME_MINUTES=15
# Unsubscribe links in emails stay valid this long (default ~10 years).
UNSUBSCRIBE_TOKEN_LIFETIME_DAYS=3650
ACCOUNT_OTP_EXPIRATION_MINUTES=5
TOTP_ISSUER_NAME=Revel

# ============================================================================
# Stripe Payment Configuration
# ============================================================================
STRIPE_ACCOUNT=acct_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Comma-separated signing secrets (platform + Connect). Produced by
# `manage.py provision_stripe_webhooks`; the setup.sh wizard captures these for you.
STRIPE_WEBHOOK_SECRETS=
DEFAULT_CURRENCY=EUR
# Revel's platform fee on top of Stripe's own processing fee (letsrevel.io: 1.5% + EUR 0.25)
DEFAULT_PLATFORM_FEE_PERCENT=1.50
DEFAULT_PLATFORM_FEE_FIXED=0.25
PAYMENT_DEFAULT_EXPIRY_MINUTES=45
CONNECTED_TEST_STRIPE_ID=

# ============================================================================
# Telegram Bot Configuration
# ============================================================================
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_OTP_EXPIRATION_MINUTES=15
# Redis DB index for aiogram FSM state — see the Redis Configuration section for
# the full index map; must not equal CACHE_REDIS_DB or CELERY_REDIS_DB.
AIOGRAM_REDIS_DB=1

# ============================================================================
# LLM Configuration (Questionnaire AI Evaluation)
# ============================================================================
# Only used when FEATURE_LLM_EVALUATION=True
# LLM_DEFAULT_MODEL=openai/gpt-4o-mini
# LLM_API_KEY=sk-...

# ============================================================================
# Security & File Uploads
# ============================================================================
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ============================================================================
# Geo & Location Services
# ============================================================================
IP2LOCATION_TOKEN=

# ============================================================================
# Notifications
# ============================================================================
NOTIFICATION_RETENTION_DAYS=90

# ============================================================================
# Observability Configuration
# ============================================================================
# Must match the 'observability' compose profile: if True without the collector
# running, the backend repeatedly fails to export OTLP. (ENABLE_OBSERVABILITY is
# still accepted as a deprecated alias.) The OTLP endpoint must point at the
# tempo container, not localhost.
FEATURE_OBSERVABILITY=True
SERVICE_NAME=revel
DEPLOYMENT_ENVIRONMENT=production
HOSTNAME=revel-production
TRACING_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
LOKI_URL=http://loki:3100

# ============================================================================
# Silk Profiling (Optional)
# ============================================================================
SILK_PROFILER=False

# ============================================================================
# Apple Wallet Pass Configuration (Optional)
# ============================================================================
# Required to enable Apple Wallet ticket passes
# Place certificate files in ./certs/ directory on the server
# APPLE_WALLET_PASS_TYPE_ID=pass.com.example.event
# APPLE_WALLET_TEAM_ID=XXXXXXXXXX
# APPLE_WALLET_CERT_PATH=/app/certs/pass-certificate.pem
# APPLE_WALLET_KEY_PATH=/app/certs/pass-key.pem
# APPLE_WALLET_KEY_PASSWORD=your-key-password
# APPLE_WALLET_WWDR_CERT_PATH=/app/certs/wwdr-certificate.pem

# ============================================================================
# OAuth 2.1 / OpenID Connect Provider (Optional)
# ============================================================================
# Lets third-party apps and MCP hosts act on a user's behalf, and other sites
# offer "Sign in with" this instance. OFF unless BOTH are set: every /o/* and
# discovery route 404s. The setup.sh wizard does all of this for you.
#
# Key: RSA 2048, unencrypted PKCS8 PEM, in ./certs (mounted at /app/certs):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out certs/oidc.pem
#   chmod 644 certs/oidc.pem
# The containers run as uid 997, so the key MUST be 644: an unreadable key leaves the
# provider off (the rest of the API keeps serving) and every management command warns
# oauth.W002. Set OAUTH_ISSUER together with the key: a readable key without an issuer
# fails the oauth.E001 check and stops web (which migrates on start) from starting.
# Never regenerate it in place, and BACK IT UP SEPARATELY: it is not in the database
# backups, and losing it invalidates every ID token already issued (access and
# refresh tokens live in the database and are unaffected). To rotate, generate a new
# key, point OIDC_SIGNING_KEY_PATH at it and list the old path in
# OIDC_SIGNING_KEYS_INACTIVE_PATHS (comma-separated) until old ID tokens expire.
#
# OAUTH_ISSUER is exactly the public API origin, no trailing slash; it must match
# where /.well-known/openid-configuration is served.
# OIDC_SIGNING_KEY_PATH=/app/certs/oidc.pem
# OIDC_SIGNING_KEYS_INACTIVE_PATHS=
# OAUTH_ISSUER=https://api.letsrevel.io
# Optional tuning (defaults shown): third-party apps per user, daily cap on
# dynamic client registrations (instance-wide), and hours before an unused registered client is deleted.
# OAUTH_MAX_APPS_PER_USER=10
# OAUTH_DCR_DAILY_CAP=500
# OAUTH_DCR_UNUSED_TTL_HOURS=24

# ============================================================================
# Grafana Configuration
# ============================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_in_production

# ============================================================================
# Alertmanager / Pushover Configuration
# ============================================================================
# Get your Pushover credentials at: https://pushover.net/
# User Key: Your user or group key
# App Token: Create an API token/application for Revel alerts
PUSHOVER_USER_KEY=your_user_key_here
PUSHOVER_APP_TOKEN=your_app_token_here
# Optional: Discord webhook for admin alerts.
DISCORD_ADMIN_WEBHOOK_URL=
# Optional: Discord webhooks for "deployment is live" notifications, posted by
# deploy.sh (update) and deploy-rollout.sh (deploy). Leave blank to disable —
# the deploy never fails if these are unset or Discord is unreachable. Use
# separate URLs to route backend/frontend pings to different channels.
DISCORD_BACKEND_WEBHOOK_URL=
DISCORD_FRONTEND_WEBHOOK_URL=

# ============================================================================
# Login Canary Configuration
# ============================================================================
# Credentials for the synthetic login canary (canary service). Use a dedicated
# prod account with NO org/staff roles and 2FA DISABLED (a 2FA-gated login
# returns HTTP 200 + temp token, not the 303 the canary treats as success).
# Without these the canary container exits 1 (canary_misconfigured) and crash-loops.
# Runs only when 'canary' is in COMPOSE_PROFILES (its own opt-in profile).
CANARY_EMAIL=canary@letsrevel.io
CANARY_PASSWORD=change_me_high_entropy

# ============================================================================
# SLIM PRESET (~2 vCPU / 4 GB box, single-org instance)
# ============================================================================
# Uncomment to override the full/production defaults above. The setup.sh wizard
# writes these for you when you pick the "slim" tier.
# COMPOSE_PROFILES=
# CADDYFILE_PATH=./Caddyfile.generic
# FEATURE_MALWARE_SCAN=False
# FEATURE_TELEGRAM=False
# FEATURE_ORGANIZATION_CREATION=False
# PG_SHARED_BUFFERS=256MB
# PG_EFFECTIVE_CACHE_SIZE=1GB
# PG_MAINTENANCE_WORK_MEM=128MB
# PG_WORK_MEM=8MB
# PG_MAX_CONNECTIONS=50
# WEB_MEM_LIMIT=1500m
# CELERY_MEM_LIMIT=768m
# FRONTEND_MEM_LIMIT=512m
# REDIS_MEM_LIMIT=256m
# REDIS_MAXMEMORY=200mb
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=2
# CELERY_CONCURRENCY=2
# WEB_CPU_LIMIT=2
# CELERY_CPU_LIMIT=1.5
# EMAIL_DRY_RUN=True
