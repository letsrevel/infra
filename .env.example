# ============================================================================
# Database Configuration
# ============================================================================
DB_NAME=revel_db
DB_USER=revel_user
DB_PASSWORD=change_me_in_production
DB_HOST=pgbouncer
DB_PORT=6432
DB_USE_PGBOUNCER=True
# Will be set to 0 if DB_USE_PGBOUNCER=True
DB_CONN_MAX_AGE=60
# Will only be used if DB_USE_PGBOUNCER=False
DB_CONN_HEALTH_CHECKS=True

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================================================
# Django Core Configuration
# ============================================================================
SECRET_KEY=change_me_in_production
SALT_KEY=change_me_in_production
DEBUG=False
DEMO_MODE=False
ALLOWED_HOSTS=.letsrevel.io,localhost,127.0.0.1
ADMIN_URL=admin/

# ============================================================================
# Site Configuration
# ============================================================================
SITE_NAME=Revel
SITE_DOMAIN=beta-api.letsrevel.io
BASE_URL=https://beta-api.letsrevel.io
FRONTEND_BASE_URL=https://beta.letsrevel.io
SERVICE_DESCRIPTION="The Revel API"

# ============================================================================
# Google SSO (Django Admin & Flower)
# ============================================================================
GOOGLE_SSO_CLIENT_ID=your_client_id_here
GOOGLE_SSO_CLIENT_SECRET=your_client_secret_here
GOOGLE_SSO_PROJECT_ID=your_project_id_here
GOOGLE_SSO_SUPERUSER_LIST=admin@yourdomain.com
GOOGLE_SSO_STAFF_LIST=

# ============================================================================
# Flower Configuration (Celery Monitoring)
# ============================================================================
FLOWER_AUTH_EMAIL=.*@yourdomain.com

# ============================================================================
# Email Configuration
# ============================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@letsrevel.io
EMAIL_HOST_PASSWORD=change_me_in_production
EMAIL_USE_SSL=False
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Revel <noreply@letsrevel.io>
INTERNAL_CATCHALL_EMAIL=internal@letsrevel.io
EMAIL_DRY_RUN=False

# ============================================================================
# Celery Configuration
# ============================================================================
CELERY_REDIS_DB=0
CELERY_TASK_ALWAYS_EAGER=False

# ============================================================================
# JWT & Authentication
# ============================================================================
JWT_ALGORITHM=HS256
JWT_AUDIENCE=letsrevel.io
ACCESS_TOKEN_LIFETIME_HOURS=1
REFRESH_TOKEN_LIFETIME_DAYS=30
VERIFY_TOKEN_LIFETIME_MINUTES=15
UNSUBSCRIBE_TOKEN_LIFETIME_DAYS=30
ACCOUNT_OTP_EXPIRATION_MINUTES=5
TOTP_ISSUER_NAME=Revel

# ============================================================================
# Stripe Payment Configuration
# ============================================================================
STRIPE_ACCOUNT=acct_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
DEFAULT_CURRENCY=EUR
DEFAULT_PLATFORM_FEE_PERCENT=3.00
DEFAULT_PLATFORM_FEE_FIXED=0.50
PAYMENT_DEFAULT_EXPIRY_MINUTES=45
CONNECTED_TEST_STRIPE_ID=

# ============================================================================
# Telegram Bot Configuration
# ============================================================================
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_SUPERUSER_IDS=
TELEGRAM_STAFF_IDS=
TELEGRAM_OTP_EXPIRATION_MINUTES=15
AIOGRAM_REDIS_DB=1

# ============================================================================
# OpenAI Configuration
# ============================================================================
OPENAI_API_KEY=sk-...

# ============================================================================
# Security & File Uploads
# ============================================================================
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ============================================================================
# Geo & Location Services
# ============================================================================
IP2LOCATION_TOKEN=

# ============================================================================
# Notifications
# ============================================================================
NOTIFICATION_RETENTION_DAYS=90

# ============================================================================
# Observability Configuration
# ============================================================================
ENABLE_OBSERVABILITY=True
SERVICE_NAME=revel
DEPLOYMENT_ENVIRONMENT=production
HOSTNAME=revel-production
TRACING_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
LOKI_URL=http://loki:3100

# ============================================================================
# Silk Profiling (Optional)
# ============================================================================
SILK_PROFILER=False

# ============================================================================
# Apple Wallet Pass Configuration (Optional)
# ============================================================================
# Required to enable Apple Wallet ticket passes
# Place certificate files in ./certs/ directory on the server
# APPLE_WALLET_PASS_TYPE_ID=pass.com.example.event
# APPLE_WALLET_TEAM_ID=XXXXXXXXXX
# APPLE_WALLET_CERT_PATH=/app/certs/pass-certificate.pem
# APPLE_WALLET_KEY_PATH=/app/certs/pass-key.pem
# APPLE_WALLET_KEY_PASSWORD=your-key-password
# APPLE_WALLET_WWDR_CERT_PATH=/app/certs/wwdr-certificate.pem

# ============================================================================
# Grafana Configuration
# ============================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_in_production

# ============================================================================
# Alertmanager / Pushover Configuration
# ============================================================================
# Get your Pushover credentials at: https://pushover.net/
# User Key: Your user or group key
# App Token: Create an API token/application for Revel alerts
PUSHOVER_USER_KEY=your_user_key_here
PUSHOVER_APP_TOKEN=your_app_token_here
