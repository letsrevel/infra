// Grafana Alloy configuration for eBPF-based continuous profiling
// This configuration enables Python profiling for Docker containers

// Discover local Docker containers
discovery.docker "local_containers" {
  host = "unix:///var/run/docker.sock"
}

// Filter to only profile Python services (web, celery, beat)
// Uses Docker Compose labels for compatibility with docker-rollout
discovery.relabel "python_services" {
  targets = discovery.docker.local_containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "(web|celery_default|beat)"
    action        = "keep"
  }
}

// eBPF profiling component
pyroscope.ebpf "instance" {
  forward_to = [pyroscope.write.endpoint.receiver]
  targets    = discovery.relabel.python_services.output

  // Language-specific profiling (Python enabled by default)
  python_enabled = true

  // Profiling configuration
  collect_interval = "15s"  // How often to collect profiles
  sample_rate      = 97     // Stack traces per second (prime number for better distribution)

  // Demangle C++ symbols (useful for native extensions)
  demangle = "simplified"
}

// Send profiles to Pyroscope server
pyroscope.write "endpoint" {
  endpoint {
    url = "http://pyroscope:4040"
  }

  external_labels = {
    "environment" = env("DEPLOYMENT_ENVIRONMENT"),
    "service"     = "revel",
    "instance"    = env("HOSTNAME"),
  }
}

// =============================================================================
// Log collection — scrape Docker container logs, parse structlog JSON, push to Loki
// =============================================================================

// Filter Docker targets to application services only
discovery.relabel "log_services" {
  targets = discovery.docker.local_containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "(web|celery_default|beat|telegram)"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service_name"
  }
}

// Scrape container logs via Docker API
loki.source.docker "app_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.log_services.output
  forward_to = [loki.process.parse_json.receiver]
}

// Parse structlog JSON, extract level label, use structlog timestamp
loki.process "parse_json" {
  forward_to = [loki.write.default.receiver]

  stage.json {
    expressions = {
      level       = "level",
      timestamp   = "timestamp",
      msg         = "event",
      trace_id    = "trace_id",
      request_id  = "request_id",
      method      = "method",
      path        = "path",
      status_code = "status_code",
      user_id     = "user_id",
    }
  }

  stage.labels {
    values = {
      level = "",
    }
  }

  stage.structured_metadata {
    values = {
      trace_id    = "",
      request_id  = "",
      method      = "",
      path        = "",
      status_code = "",
      user_id     = "",
    }
  }

  // Replace raw JSON blob with just the event message
  stage.output {
    source = "msg"
  }

  stage.timestamp {
    source = "timestamp"
    format = "2006-01-02T15:04:05.999999Z07:00"
  }
}

// Push logs to Loki
loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }

  external_labels = {
    "environment" = env("DEPLOYMENT_ENVIRONMENT"),
  }
}
