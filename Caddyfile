{
	# Global options for better performance
	servers {
		max_header_size 16KB

		# Real client IP behind Cloudflare.
		# Cloudflare is the only thing in front of us, and it sends the true
		# visitor IP in `CF-Connecting-IP`. By trusting ONLY Cloudflare's IP
		# ranges, Caddy resolves `{client_ip}` to the real visitor and ignores
		# any `CF-Connecting-IP` / `X-Forwarded-For` sent by a non-Cloudflare
		# peer (so the value cannot be spoofed by hitting the origin directly).
		# Ranges from https://www.cloudflare.com/ips/ — refresh occasionally.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers Cf-Connecting-Ip
	}

	# On-demand TLS for organization custom domains (white-label, infra#67).
	# Only the `https://` catch-all at the end of this file uses it; every named
	# site keeps its normal certificate. Before issuing a certificate for an
	# unknown hostname Caddy calls the backend's dedicated ask endpoint
	# (`GET /api/tls/ask?domain=<host>`, revel-backend#1178) straight over the
	# docker network. It answers 200 only for an ACTIVE custom domain whose
	# organization has custom_domain_enabled, 404 otherwise, and it is
	# unthrottled and cached, so junk handshakes cannot starve real tenants and
	# nobody can make this server request certificates for arbitrary names.
	# With no active custom domains the catch-all is inert.
	on_demand_tls {
		ask http://web:8000/api/tls/ask
	}

	# Redact bearer credentials from every Caddy log line (infra#55).
	# Unsubscribe/opt-out links (`?token=`, a JWT carrying the recipient's
	# email, valid ~10 years), password-reset / confirm-email / impersonation
	# links (`?token=`), signed media URLs (`?sig=`) and the OAuth/OIDC login
	# callbacks (`?code=`, replayable until redeemed) all travel in query
	# strings. There is no `log` directive, so no access log is written, but
	# `http.log.error` (e.g. a 502 while an upstream restarts) still dumps the
	# full request: uri plus the Referer, which carries the page URL. Filtering
	# the default logger scrubs them before they reach `docker logs`. The key
	# stays visible so you can tell a token was present.
	log default {
		format filter {
			request>uri query {
				replace token REDACTED
				replace sig REDACTED
				replace code REDACTED
			}
			request>headers>Referer query {
				replace token REDACTED
				replace sig REDACTED
				replace code REDACTED
			}
		}
	}
}

# -------------------------------------------------------
# Redirect www to root
# -------------------------------------------------------
# (beta.letsrevel.io / beta-api.letsrevel.io moved to the beta server: their
# DNS no longer points here, so prod could never renew certificates for them.)
www.letsrevel.io {
	redir https://letsrevel.io{uri} permanent
}

# -------------------------------------------------------
# Revel Frontend
# -------------------------------------------------------
# Everything the frontend serves, shared by the platform host and the
# organization custom-domain catch-all (end of file) so the two can never
# drift apart. HSTS is NOT in here: each site sets its own, because custom
# domains must not get includeSubDomains/preload (infra#67).
(revel_frontend) {
	encode zstd gzip

	# --- Security headers (applied to all responses) ---
	header X-Content-Type-Options "nosniff"
	header Cross-Origin-Resource-Policy "same-origin"
	header Permissions-Policy "camera=(), microphone=(), usb=()"
	header Cross-Origin-Opener-Policy "same-origin-allow-popups"

	# --- Drop common vuln-scanner probes at the edge ---
	# Bots hammer nonexistent PHP shells and exposed dotfiles (/.env, /.git/*).
	# SvelteKit turned these into 404s logged as SSR errors, which tripped the
	# FrontendSSRErrors alert. Answer them here so they never reach the Node SSR
	# process. `.well-known/*` is intentionally NOT matched (it is legitimate).
	@scanner_probe path *.php *.phtml *.asp *.aspx *.jsp *.cgi /.env* /.git* /.svn* /.hg* /.DS_Store /wp-* /wordpress*
	handle @scanner_probe {
		respond 404
	}

	# SvelteKit deploy/runtime metadata must never be long-cached: version.json
	# is how a stale tab detects a new deploy (kit.version.pollInterval on the
	# frontend), and env.js carries the runtime PUBLIC_* env (frontend#396).
	# Must precede @static, which would otherwise catch them via *.js — and
	# DID, serving both with a year-long immutable cache.
	@app_meta {
		path /_app/version.json /_app/env.js
	}
	handle @app_meta {
		reverse_proxy frontend:3000 {
			transport http {
				keepalive 90s
				keepalive_idle_conns 32
				max_conns_per_host 100
			}
			# Tenant mode: the frontend (HOST_HEADER / PROTOCOL_HEADER) reads the
			# public host and scheme from these to pick the organization. Set
			# explicitly to OVERWRITE client values: a trusted proxy's
			# X-Forwarded-Host would otherwise pass through unchanged (infra#67).
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
		}
		header Cache-Control "no-cache"
	}

	# The embed loaders are versioned by NAME (embed-v1) and updated in place —
	# the embed builder promises third-party sites the script "keeps working
	# when we ship improvements", which the immutable cache they previously
	# fell into (via *.js) broke.
	@embed_loader {
		path /embed-v1.js /embed-frame-v1.js
	}
	handle @embed_loader {
		reverse_proxy frontend:3000 {
			transport http {
				keepalive 90s
				keepalive_idle_conns 32
				max_conns_per_host 100
			}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
		}
		header Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
		# Embedding sites load these via <script src> — a cross-origin no-cors
		# request, which is exactly what CORP polices. The site-wide
		# `same-origin` above otherwise blocks the load outright
		# (net::ERR_BLOCKED_BY_RESPONSE.NotSameOrigin — reproduced against
		# prod). The in-handle override wins over the top-level header because
		# it runs later in the middleware chain (verified against local Caddy).
		header Cross-Origin-Resource-Policy "cross-origin"
	}

	# Static assets with long cache. `immutable` applies ONLY to the content-
	# hashed /_app/immutable/ tree — a broader /_app/* used to freeze
	# version.json and env.js for a year (see @app_meta above).
	@static {
		path /_app/immutable/* /images/* /fonts/* *.js *.css *.woff2 *.png *.jpg *.jpeg *.svg *.ico
	}
	handle @static {
		reverse_proxy frontend:3000 {
			transport http {
				keepalive 90s
				keepalive_idle_conns 32
				max_conns_per_host 100
			}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
			# Static assets can be buffered (flush_interval -1 removed for consistency)
		}
		header Cache-Control "public, max-age=31536000, immutable"
		# Public brand assets (og-image, logos, icons) must be embeddable
		# cross-origin: social-preview tools and og:image/og:logo consumers
		# load them via <img> from their own origin, and CORP "same-origin"
		# blocks exactly that (issue #32). The override MUST live inside this
		# handle: as a top-level matched `header` (how #33 shipped it) Caddy
		# sorted it before the bare `same-origin`, which ran last and
		# clobbered it — og images were being blocked again
		# (net::ERR_BLOCKED_BY_RESPONSE.NotSameOrigin, reproduced against
		# prod). In-handle ops run later in the chain and win, the same
		# pattern as the embed loaders above.
		@shareable_asset path /og-*.png /logo* /favicon* /apple-touch-icon* /revel-email-logo*
		header @shareable_asset Cross-Origin-Resource-Policy "cross-origin"
	}

	# Public machine-readable files — cacheable, no user-specific data.
	# /legal was dropped from this list: it is SSR HTML referencing content-
	# hashed assets, so a cached copy spanning a deploy renders unstyled —
	# the same failure mode the @html block used to inflict on `/`.
	@public_pages {
		path /robots.txt /sitemap.xml
	}
	handle @public_pages {
		reverse_proxy frontend:3000 {
			transport http {
				keepalive 90s
				keepalive_idle_conns 32
				max_conns_per_host 100
			}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
			header_up X-Real-IP {client_ip}
		}
		header Cache-Control "public, max-age=3600, stale-while-revalidate=300"
	}

	# Everything else — SSR HTML, including `/` (the old @html block gave the
	# landing page `public, max-age=30` + SWR, the same stale-document window).
	handle {
		reverse_proxy frontend:3000 {
			transport http {
				keepalive 90s
				keepalive_idle_conns 32
				max_conns_per_host 100
			}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
			# Enable streaming for all SSR responses (removed flush_interval -1)
			# Real visitor IP for SvelteKit's getClientAddress() (adapter-node
			# reads it via ADDRESS_HEADER=x-real-ip). SSR forwards it to the
			# backend over the internal network — see backend#487.
			header_up X-Real-IP {client_ip}
		}
		# Default only (`?` = set-if-absent): routes that opt into caching
		# (feeds, sitemaps, oembed, /embed) keep their own header. Documents
		# with NO Cache-Control get heuristic-cached by browsers — iOS Safari
		# restores them across deploys, and the stale HTML then references
		# hashed assets the new deploy no longer ships: an unstyled page until
		# a manual reload. `no-cache` = store but always revalidate.
		header ?Cache-Control "private, no-cache"
	}
}

{$FRONTEND_DOMAIN:letsrevel.io} {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	import revel_frontend
}

# -------------------------------------------------------
# Revel API
# -------------------------------------------------------
{$API_DOMAIN:api.letsrevel.io} {
	# --- Security headers (applied to all responses) ---
	header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	header X-Content-Type-Options "nosniff"
	header Cross-Origin-Resource-Policy "cross-origin"
	header Permissions-Policy "camera=(), microphone=(), usb=()"

	encode zstd gzip

	# --- Drop vuln-scanner probes at the edge ---
	# Bots probe the API host for dotfiles, PHP shells and dev-server paths.
	# Answering here keeps them out of Django's response metrics, where they
	# inflated the HighHTTP4xxRate ratio. Real API routes all live under /api/.
	@scanner_probe path *.php *.phtml *.asp *.aspx *.jsp *.cgi /.env* /.git* /.svn* /.hg* /.DS_Store /wp-* /wordpress* /@fs/* /__vite* /userfiles* /webhook* /feast/* /form/*
	handle @scanner_probe {
		respond 404
	}

	# Block access to metrics endpoint (internal use only)
	handle /metrics* {
		respond "Not Found" 404
	}

	# Protected media files - require signed URL validation
	# Single rule covers ALL protected files (protected/file/*, protected/questionnaire_files/*, etc.)
	handle_path /media/protected/* {
		# `route` keeps literal order: the CORS header must run AFTER forward_auth
		# has copied Django's answer into the request.
		route {
			# Validate signature with Django. Django also decides CORS: the
			# forwarded request keeps the browser's Origin, so django-cors-headers
			# answers with Access-Control-Allow-Origin only for an allowed origin
			# (CORS_ALLOWED_ORIGINS, or an ACTIVE organization custom domain via
			# dynamic CORS). copy_headers lifts it into a request header (and strips
			# any client-sent copy) and we echo it. Replaces the origin that was
			# pinned to FRONTEND_DOMAIN, which broke media on custom domains (infra#67).
			# forward_auth sends preflights as GET too, so OPTIONS is covered.
			# Drop any client-sent copy first (older Caddy versions' copy_headers
			# only overwrite it when Django answers with the header).
			request_header -X-Revel-Cors-Origin
			# Note: handle_path strips /media/protected from {uri}, so we add /protected back
			forward_auth web:8000 {
				uri /api/media/validate/protected{uri}
				copy_headers Access-Control-Allow-Origin>X-Revel-Cors-Origin
			}
			@cors_allowed header X-Revel-Cors-Origin *
			header @cors_allowed Access-Control-Allow-Origin "{http.request.header.X-Revel-Cors-Origin}"
			header +Vary Origin
			header Access-Control-Allow-Credentials "true"
			header Access-Control-Allow-Methods "GET, OPTIONS"
			header Access-Control-Allow-Headers "Authorization, Content-Type"

			# Handle CORS preflight
			@options method OPTIONS
			respond @options 204

			# Private caching (browser only, not CDN)
			header Cache-Control "private, max-age=3600"

			# Serve from media directory
			# Note: handle_path strips /media/protected, so root must include /protected
			root * /srv/revel_media/protected
			file_server
		}
	}

	# Public media files - served directly without validation
	# (logos, cover-art, and other non-protected content)
	handle_path /media/* {
		root * /srv/revel_media
		file_server
		header Cache-Control "public, max-age=86400"
	}

	# Hosted geo datasets served for self-host setup.sh (worldcities.csv,
	# IP2LOCATION-LITE-DB5.BIN, NOTICE). On self-host boxes the dir is empty -> 404.
	handle_path /geo-data/* {
		root * /srv/geo-data
		file_server
		header Cache-Control "public, max-age=86400"
	}

	# Proxy all other requests to Django
	handle {
		reverse_proxy web:8000 {
			transport http {
				keepalive 90s
				keepalive_idle_conns 32
				max_conns_per_host 100
			}
			# Removed flush_interval -1 for consistency (Django responses are typically not streamed)
			# Pass the REAL visitor IP (resolved from Cf-Connecting-Ip via the
			# trusted_proxies config above) to Django. We overwrite X-Forwarded-For
			# with the single trusted client IP so the existing backend code
			# (observability/geo middleware, ninja_extra throttling with
			# NUM_PROXIES=1, impersonation audit) keys on the real visitor instead
			# of a Cloudflare edge IP — no backend change required. Keep NUM_PROXIES=1.
			header_up X-Real-IP {client_ip}
			header_up X-Forwarded-For {client_ip}
			# Strip the inbound Cf-Connecting-Ip so Django never sees a
			# client-forgeable copy (a direct-to-origin peer could set it;
			# its trusted value is already resolved into the headers above).
			header_up -Cf-Connecting-Ip
		}
	}
}

# -------------------------------------------------------
# Revel Docs
# -------------------------------------------------------
{$DOCS_DOMAIN:docs.letsrevel.io} {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	encode zstd gzip
	root * /srv/docs
	file_server

	# Cache: short for HTML, a day for static assets. `route` is load-bearing:
	# outside it Caddy sorts same-name `header` directives matched-first, so
	# the bare HTML policy ran last and clobbered @static — hashed assets
	# shipped with max-age=300 (verified live via the stale-while-revalidate
	# fingerprint on a .min.css). Inside `route` literal order holds, and
	# file_server sorts after route, so both ops run before the response.
	@static {
		path *.js *.css *.woff2 *.png *.jpg *.jpeg *.svg *.ico
	}
	route {
		header Cache-Control "public, max-age=300, stale-while-revalidate=60"
		header @static Cache-Control "public, max-age=86400"
	}
}

# Public file drop (vademecums, brand assets, anything linked from events),
# mirroring public.biagiodistefano.io. Whatever sits in ./public on the server
# is world-readable and listed by `browse`, so only put files there that are
# meant to be public. Production only, like DOCS_DOMAIN.
{$PUBLIC_DOMAIN:public.letsrevel.io} {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	encode zstd gzip
	root * /srv/public
	file_server browse
}

# -------------------------------------------------------
# Revel Grafana
# -------------------------------------------------------
{$GRAFANA_DOMAIN:grafana.letsrevel.io} {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	reverse_proxy revel_grafana:3000
	encode gzip
}

# -------------------------------------------------------
# Organization custom domains (white-label, infra#67)
# -------------------------------------------------------

# Fallback origin: organizations CNAME their domain to this name (the backend's
# CUSTOM_DOMAIN_CNAME_TARGET, read from .env here too) and it is
# registered as the zone's Cloudflare for SaaS fallback origin. Set it up like
# every other host: DNS-only (grey) until Caddy has its certificate, then
# proxied (orange).
# Requests to the name itself go to the platform; customer traffic arrives with
# the CUSTOMER's Host and lands in the catch-all below. Unset, it resolves to an
# internal .localhost name (no public ACME attempt), like Grafana's default.
{$CUSTOM_DOMAIN_CNAME_TARGET:customers.localhost} {
	redir https://{$FRONTEND_DOMAIN:letsrevel.io}{uri}
}

# Catch-all for organization custom domains. Caddy matches named sites first,
# so this only sees hostnames no block above claims. Cloudflare for SaaS connects with
# SNI = Host = the customer hostname and, under Full (strict), needs a publicly
# trusted certificate for that name: on-demand TLS gets one from Let's Encrypt,
# gated by the ask endpoint
# configured in the global options. TLS-ALPN cannot pass through Cloudflare's
# proxy, so only HTTP-01 is used (Cloudflare forwards port 80).
https:// {
	tls {
		on_demand
		issuer acme {
			disable_tlsalpn_challenge
		}
	}

	# Not our domains: no includeSubDomains, no preload.
	header Strict-Transport-Security "max-age=86400"
	import revel_frontend
}
