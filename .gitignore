# Environment files
.env

# Data directories
media/*
!media/.gitkeep

geo-data/*
!geo-data/.gitkeep
!geo-data/NOTICE

sentinel/*
!sentinel/.gitkeep

certs/*
!certs/.gitkeep

# Extracted Caddy internal CA root cert (regenerated per-instance via
# `docker cp` from the caddy container — see docker-compose.override.yml)
local-ca/

# Backup files
*.bak
*.backup

# Docker volumes
*.log
.idea/