# Environment files
.env

# Data directories
media/*
!media/.gitkeep

geo-data/*
!geo-data/.gitkeep
!geo-data/NOTICE

sentinel/*
!sentinel/.gitkeep

certs/*
!certs/.gitkeep

# Backup files
*.bak
*.backup

# Docker volumes
*.log
.idea/
# Secret rotation (local state, archives of retired secrets, env backups)
**/rotation/state.json
**/rotation/state.lock
**/rotation/archive/
.env.bak.*
..env.tmp.*
.state.json.tmp.*
__pycache__/
